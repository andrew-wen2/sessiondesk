// SessionDesk data model. Per-user multi-tenant: User owns Student/Session.
// Payment is a boolean on Session (YAGNI). "Learned so far" is derived from
// session topics, never stored. ReferenceProblem is a global shared corpus.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String // bcrypt; never returned to the client. Empty for accounts
  // created via Google sign-in until the user sets a password (verifyPassword
  // rejects an empty hash, so a Google-only account can't be password-logged-in).
  // Google identity (OAuth "sub"), set when the user signs in with Google. Linked
  // to the account whose email matches; null for password-only accounts.
  googleId     String?   @unique
  // Per-user Google Calendar link. Refresh token is the user's own OAuth grant
  // (server-side only, never sent to the client); calendarId is the calendar to
  // mirror into (null → "primary"). App client id/secret stay in env.
  googleRefreshToken String?
  googleCalendarId   String?
  // Shown to STUDENTS on a shared practice link ("From Andrew"). A page with no
  // identity on an unfamiliar domain reads as phishing, and the tutor's own first
  // name is not the student's data. Deriving it from `email` instead would leak the
  // tutor's address handle to anyone holding a link, and hardcoding a name is wrong
  // in a multi-user app. Null falls back to "your tutor".
  displayName  String?
  createdAt    DateTime  @default(now())
  students     Student[]
  sessions     Session[]
  submissions  Submission[]
  generationAttempts GenerationAttempt[]
}

model Student {
  id            String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  parentContact  String?
  // Subject, level, and goals as one free-text description ("AIME, problems 10–15";
  // "AP Biology, unit 3 genetics — shaky on meiosis"). The SOLE calibration input:
  // the generation plan infers domain, difficulty, and answer format from this plus
  // the session topic. There is no stored subject or engine selector — keep it specific.
  profile        String @default("")
  rate           Int // default dollars per session
  notes          String?
  meetLink       String?  // one Google Meet URL, mirrored to all of this student's GCal events
  // Moves this student into the "Past students" section of the roster
  // (app/students/page.tsx) instead of the main list, once they're no longer being
  // taught. Reversible, no cascade — sessions, payments, and the Add-session combobox
  // are all untouched by this flag; it only changes which roster section they render
  // in. Nothing is ever hidden by it — an archived student who still owes money shows
  // up in Past students the same as anyone else, just segregated, never suppressed.
  archived       Boolean  @default(false)
  sessions       Session[]
  submissions    Submission[]
  createdAt      DateTime  @default(now())

  @@index([userId])
}

// Read-only reference corpus of real past competition problems. Used to retrieve
// same-difficulty "anchor" examples that calibrate generation. Not a user-facing
// problem bank; never redistributed. Global — shared across all users, not owned.
model ReferenceProblem {
  id        String   @id @default(cuid())
  source    String // "AMC10" | "AMC12" | "AIME" | "Fma"
  year      Int?
  number    Int? // problem position → difficulty proxy
  category  String? // "algebra" | "number_theory" | "geometry" | "combinatorics" | "mechanics"
  statement String
  answer    String?
  solution  String?
  createdAt DateTime @default(now())

  // No @@unique on (source, year, number): years from 2000+ have AIME I and II,
  // both numbered 1–15. Idempotency is via a deterministic primary id at ingest.
  @@index([source, number])
  @@index([category])
}

model Session {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  student       Student  @relation(fields: [studentId], references: [id])
  studentId     String
  start         DateTime
  durationMin   Int      @default(60)
  topic         String   @default("")
  problems      Json?
  lesson        Json?    // generated lesson blob (title/objectives/sections/workedExamples/practice); parallel to `problems`
  // Generation provenance: {v, problems?, lesson?} — provider/model per stage, per-item
  // verification verdicts, token counts, drop reasons. Written by both /api/generate and
  // /api/generate-lesson (same row, keyed by producer), and on failure too. Shape lives in
  // lib/generation/gen-meta.ts (GenMeta, parseGenMeta). Readable by session id only — a
  // Json column can't be filtered without queryRaw, which this repo forbids; don't plan
  // analytics on it. Existing rows read NULL — treat as unknown provenance, not zero cost.
  genMeta       Json?
  amount        Int
  paid          Boolean  @default(false)
  // Lifecycle: "scheduled" | "completed" | "cancelled" | "no_show". String (not a
  // Prisma enum) so an unexpected value normalizes on read instead of throwing.
  // Validated on write and backed by a CHECK constraint; helpers live in
  // lib/session-status.ts.
  status        String   @default("scheduled")
  // Groups the rows materialized from one recurrence rule; null = standalone session.
  // Deliberately a bare key, not a Series model: there is no series-level state worth
  // storing, and a table would add a join for a nullable grouping key.
  seriesId      String?
  googleEventId String?  @unique
  // --- Student practice link (app/w/[[...token]]) ---
  // 256-bit bearer token, minted on Send, nulled on Revoke. The token is a CREDENTIAL,
  // never the identity: it resolves to a session and thence to a studentId, which is
  // what every submission is keyed by. That is what makes adding real student accounts
  // later purely additive.
  shareToken    String?  @unique
  // Set on Send and deliberately NOT cleared on Revoke: "sent five days ago, nothing
  // back" is the completion signal this whole feature exists to produce, and it has to
  // survive the tutor turning the link off. Also the expiry anchor — NOT session.start,
  // which the calendar mutates on every drag-to-reschedule.
  sentAt        DateTime?
  // The problem set FROZEN at Send. Serving and grading read this, never `problems`.
  // Two paths rewrite `problems` after a link is live (/api/generate, and the
  // module-level generation store that survives navigation), and countForTier is
  // deterministic so a replacement set has the SAME LENGTH — without a frozen copy,
  // answers get graded against different problems with no error and no log.
  sentSet       Json?
  submission    Submission?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([studentId])
  @@index([start])
  @@index([seriesId])
  // Every session query is userId + a start range (calendar, dashboard, ledger);
  // the single-column start index can't serve the userId predicate.
  @@index([userId, start])
  generationAttempts GenerationAttempt[]
}

// One student's work on one session's practice set. Accumulates as they go — there is
// no submit button; each problem is committed on its own the moment it is checked.
//
// Keyed by studentId, never by the token: the link is a credential that resolves to a
// student, so when real student accounts land they become a second way to authenticate
// as the same studentId and every historical row is already attributed correctly.
model Submission {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String   @unique
  // [{ index, attempts: string[], verdict, revealedAt, formatFallback? }] — one entry
  // per COMMITTED problem, appended as the student works.
  results    Json
  // Optimistic concurrency. `results` is a Json column, so every commit is a
  // read-modify-write with no atomicity under Read Committed: without a compare-and-swap
  // on this counter, N parallel requests all read the same prior array and one write
  // survives — which silently defeats the per-problem attempt cap (fire 50 guesses at
  // one index and spend one attempt) and loses work when two tabs are open.
  version    Int      @default(0)
  startedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([studentId])
}

// One row per generation attempt (problems or lesson), append-only apart from its own
// outcome. Session.genMeta keeps the latest run's provenance but is overwritten on
// regenerate, so it can't count how often generation fails; this table can. It is also
// what the per-user daily generation cap counts.
//
// `status` is a String with a CHECK constraint (same reasoning as Session.status): a
// row still "started" long after the route's 300s limit means the function was killed
// before it could record an outcome — see effectiveAttemptStatus in gen-meta.ts.
model GenerationAttempt {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  kind       String // "problems" | "lesson"
  pipeline   String? // "legacy" | "cascade" for problems; null for lessons
  tier       String? // "easy" | "mid" | "hard", once the plan is known
  status     String    @default("started") // started | ok | failed
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  wallTimeMs Int?
  kept       Int?
  asked      Int?

  @@index([userId, startedAt])
  @@index([sessionId])
}
