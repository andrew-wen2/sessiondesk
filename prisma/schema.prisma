// SessionDesk data model. Per-user multi-tenant: User owns Student/Session.
// Payment is a boolean on Session (YAGNI). "Learned so far" is derived from
// session topics, never stored. ReferenceProblem is a global shared corpus.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String // bcrypt; never returned to the client. Empty for accounts
  // created via Google sign-in until the user sets a password (verifyPassword
  // rejects an empty hash, so a Google-only account can't be password-logged-in).
  // Google identity (OAuth "sub"), set when the user signs in with Google. Linked
  // to the account whose email matches; null for password-only accounts.
  googleId     String?   @unique
  // Per-user Google Calendar link. Refresh token is the user's own OAuth grant
  // (server-side only, never sent to the client); calendarId is the calendar to
  // mirror into (null → "primary"). App client id/secret stay in env.
  googleRefreshToken String?
  googleCalendarId   String?
  createdAt    DateTime  @default(now())
  students     Student[]
  sessions     Session[]
}

model Student {
  id            String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  name           String
  parentContact  String?
  // Subject, level, and goals as one free-text description ("AIME, problems 10–15";
  // "AP Biology, unit 3 genetics — shaky on meiosis"). The SOLE calibration input:
  // the generation plan infers domain, difficulty, and answer format from this plus
  // the session topic. There is no stored subject or engine selector — keep it specific.
  profile        String @default("")
  rate           Int // default dollars per session
  notes          String?
  meetLink       String?  // one Google Meet URL, mirrored to all of this student's GCal events
  // Moves this student into the "Past students" section of the roster
  // (app/students/page.tsx) instead of the main list, once they're no longer being
  // taught. Reversible, no cascade — sessions, payments, and the Add-session combobox
  // are all untouched by this flag; it only changes which roster section they render
  // in. Nothing is ever hidden by it — an archived student who still owes money shows
  // up in Past students the same as anyone else, just segregated, never suppressed.
  archived       Boolean  @default(false)
  sessions       Session[]
  createdAt      DateTime  @default(now())

  @@index([userId])
}

// Read-only reference corpus of real past competition problems. Used to retrieve
// same-difficulty "anchor" examples that calibrate generation. Not a user-facing
// problem bank; never redistributed. Global — shared across all users, not owned.
model ReferenceProblem {
  id        String   @id @default(cuid())
  source    String // "AMC10" | "AMC12" | "AIME" | "Fma"
  year      Int?
  number    Int? // problem position → difficulty proxy
  category  String? // "algebra" | "number_theory" | "geometry" | "combinatorics" | "mechanics"
  statement String
  answer    String?
  solution  String?
  createdAt DateTime @default(now())

  // No @@unique on (source, year, number): years from 2000+ have AIME I and II,
  // both numbered 1–15. Idempotency is via a deterministic primary id at ingest.
  @@index([source, number])
  @@index([category])
}

model Session {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  student       Student  @relation(fields: [studentId], references: [id])
  studentId     String
  start         DateTime
  durationMin   Int      @default(60)
  topic         String   @default("")
  problems      Json?
  lesson        Json?    // generated lesson blob (title/objectives/sections/workedExamples/practice); parallel to `problems`
  amount        Int
  paid          Boolean  @default(false)
  // Lifecycle: "scheduled" | "completed" | "cancelled" | "no_show". String (not a
  // Prisma enum) so an unexpected value normalizes on read instead of throwing.
  // Validated on write and backed by a CHECK constraint; helpers live in
  // lib/session-status.ts.
  status        String   @default("scheduled")
  // Groups the rows materialized from one recurrence rule; null = standalone session.
  // Deliberately a bare key, not a Series model: there is no series-level state worth
  // storing, and a table would add a join for a nullable grouping key.
  seriesId      String?
  googleEventId String?  @unique
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([studentId])
  @@index([start])
  @@index([seriesId])
  // Every session query is userId + a start range (calendar, dashboard, ledger);
  // the single-column start index can't serve the userId predicate.
  @@index([userId, start])
}
