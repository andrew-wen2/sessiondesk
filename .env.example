# cp this file to .env.local. Next.js loads .env.local (and .env) automatically for
# `npm run dev`/`build`. Standalone scripts/*.ts do NOT get this for free — tsx has
# no auto-load and there's no dotenv dependency — so scripts under `npm run` are
# invoked with `tsx --env-file-if-exists=.env.local --env-file-if-exists=.env` (see
# package.json). If you add a new script, follow that pattern or it'll fail with a
# confusing "DATABASE_URL not found" rather than a clear one.

# Postgres (Neon or Supabase). Format below works for both.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Multi-user auth (middleware.ts). AUTH_SECRET signs the session cookie — set a
# long random value in prod (a blank/leaked secret lets anyone forge a session).
# A dev fallback keeps local runs working when unset.
AUTH_SECRET=""
# Optional: bootstrap login for `npx prisma db seed` (owns the seeded roster).
SEED_EMAIL=""
SEED_PASSWORD=""

# Anthropic — server-side only, never NEXT_PUBLIC_. Added in build step 4.
ANTHROPIC_API_KEY=""
# GENERATION_MODEL overrides all tier-specific vars below (global escape hatch).
GENERATION_MODEL=""
GENERATION_MODEL_HARD="claude-opus-5"       # AIME #10–15 / hardest non-contest work: reasoning-critical, stays on Opus (see GENERATION_PROVIDER below)
GENERATION_MODEL_MID="claude-sonnet-4-6"    # AMC #16–25 / AIME #1–9: scratch with adaptive thinking (ANTHROPIC path — default provider for this tier is Gemini; see below)
GENERATION_MODEL_EASY="claude-haiku-4-5"    # AMC #1–15 / unclassified: batch generate-from-scratch (ANTHROPIC path — default provider for this tier is Gemini; see below)
# Adapt path (hard/variant): the model transforms a seed's real solution into a sketch,
# then a cheap model expands it. Thinking-cost optimization for AIME #10–15.
GENERATION_MODEL_PLAN="claude-haiku-4-5"    # cheap model: classifies the subject + writes the difficulty rubric
GENERATION_MODEL_EXPAND="claude-haiku-4-5"  # cheap model: sketch → full student-facing solution
GENERATION_MODEL_VERIFY=""                  # audit model (defaults to GENERATION_MODEL_EXPAND)
GENERATION_EFFORT_ADAPT="low"               # reasoning effort for the seed-adaptation pass (low|medium|high)
GENERATION_EFFORT_ESCALATE="high"           # effort for the heavy re-solve when an audit fails
GENERATION_VERIFY=""                        # set to "1" to enable the cheap correctness audit + escalation
GENERATION_NO_ADAPT=""                      # set to "1" to disable adapt and fall back to from-scratch variants
GENERATION_NO_PLAN=""                       # set to "1" to skip the plan call and use the keyword-heuristic fallback
GENERATION_NO_SEED_SKETCH=""                # set to "1" to disable the seed-sketch distill pass (back to the one-shot adapt path)

# Independent solver (lib/generation/solve.ts) — verifies every generated
# problem's answer before it's expanded or returned; the generator's own answer
# is a hypothesis, never the stored value. Stays on Anthropic even after the
# planned Gemini swap for generation, so agreement is genuinely cross-family.
SOLVER_MODEL="claude-opus-5"
SOLVER_MODEL_ESCALATE=""                    # defaults to SOLVER_MODEL; separate override for the escalation-only calls

# Which vendor WRITES problem statements — plan, tiered generation, seed-sketch,
# expand, lessons. PER-STAGE (lib/generation/config.ts's providerForStage), not one
# switch: by default the HARD tier (the reasoning-critical one) stays on Claude
# Opus (GENERATION_MODEL_HARD above); every other stage — plan, easy, mid,
# seed-sketch, expand, lessons — runs on Gemini Flash. The solver above is
# UNAFFECTED — it always stays on Anthropic. Requires GOOGLE_API_KEY.
# FUNCTION-CALLING MODE ONLY internally — never raw JSON mode, which was confirmed
# (by direct investigation) to silently corrupt LaTeX.
GENERATION_PROVIDER=""                      # escape hatch: "anthropic" or "gemini" forces EVERY stage to that vendor. Empty (default) = the mixed hard-Opus/everything-else-Gemini policy above.
GOOGLE_API_KEY=""                           # from aistudio.google.com/apikey — server-side only, never NEXT_PUBLIC_
GEMINI_MODEL=""                             # global override, wins over every GEMINI_MODEL_* below
GEMINI_MODEL_PLAN=""                        # defaults to "gemini-3.8-flash"
GEMINI_MODEL_EASY=""
GEMINI_MODEL_MID=""
GEMINI_MODEL_HARD=""                        # only used if GENERATION_PROVIDER=gemini forces the hard tier off Opus
GEMINI_MODEL_EXPAND=""                      # also used for seed-sketch
GENERATION_EFFORT_SOLVE="high"              # reasoning effort for the solver (low|medium|high)
SOLVE_MAX_ESCALATIONS="3"                   # hard cap on additional Opus solves per set when round 1 disagrees
SOLVE_TIERS=""                              # comma-separated subset ("easy,mid,hard") to solve; empty = all tiers
GENERATION_NO_SOLVE=""                      # set to "1" to disable the solver entirely (kill switch, matches GENERATION_NO_*)

# --- Problem-generation pipeline (docs/designs/generation-cascade.md) ---------------
# Which pipeline each tier runs: "legacy" (chunked, everything above) or "cascade"
# (one problem per call, climbing a model ladder on failure). Per-tier overrides win
# over GENERATION_PIPELINE. An unknown value is an error, never a silent default.
# Check any change with `npm run gen:check` (no spend).
GENERATION_PIPELINE=""                      # default legacy
GENERATION_PIPELINE_EASY=""
GENERATION_PIPELINE_MID=""
GENERATION_PIPELINE_HARD=""
# Cascade ladder per tier: "provider:model[,provider:model...]", cheapest first, the
# last entry is the top rung. Providers: anthropic | gemini | openweight. Empty = Opus
# 5.5 alone (the interim default). Open-weight rungs go in front only after passing
# admission (hosting/PII decision, LaTeX test, correctness gate, a price row).
# Optional "@thinking" per rung (off|low|medium|high|max) overrides the tier default.
# Example: GENERATION_LADDER_MID="openweight:deepseek-flash@medium,openweight:glm-5.3,anthropic:claude-opus-5-5"
GENERATION_LADDER_EASY=""
GENERATION_LADDER_MID=""
GENERATION_LADDER_HARD=""
GENERATION_DISABLE_RUNGS=""                 # comma-separated providers or models to pull from every ladder, e.g. "openweight"
# Open-weight host (OpenAI-compatible chat completions, https only) — server-side
# only, never NEXT_PUBLIC_. Needed only when a ladder uses an openweight rung.
OPENWEIGHT_BASE_URL=""                      # e.g. https://api.deepinfra.com/v1/openai
OPENWEIGHT_API_KEY=""
# Cascade limits (defaults in parentheses).
CASCADE_MAX_CALLS=""                        # physical rung calls per request (40)
CASCADE_MAX_USD=""                          # per-request spend ceiling in dollars; empty = none
CASCADE_BREAKER_THRESHOLD=""                # provider-level failures before a provider is skipped for the request (3)
CASCADE_RUNG_TIMEOUT_EASY=""                # seconds a cheap rung gets per problem (60). Candidates run concurrently,
CASCADE_RUNG_TIMEOUT_MID=""                 # (90)  so this is per problem, not per set. Limit: a cheap rung plus the top
CASCADE_RUNG_TIMEOUT_HARD=""                # (75)  rung (+40s solver each on hard) must fit ~285s — gen:check enforces it.
CASCADE_TOP_TIMEOUT_EASY=""                 # seconds for the top rung (90)
CASCADE_TOP_TIMEOUT_MID=""                  # (120)
CASCADE_TOP_TIMEOUT_HARD=""                 # (120)
CASCADE_CONCURRENCY_ANTHROPIC=""            # in-flight calls per instance (6)
CASCADE_CONCURRENCY_OPENWEIGHT=""           # (8)
CASCADE_CONCURRENCY_GEMINI=""               # (8)
# Cascade quality gates for scratch (non-seed) candidates. See CLAUDE.md, Cascade pipeline.
CASCADE_SCRATCH_PROMPT=""                   # construct (default: build backward from a chosen answer) | classic
CASCADE_TARGET_OFFSET=""                    # shift every per-slot target position by N (0); + when a writer plays easy
CASCADE_TYPES_MODEL=""                      # openweight spec for the per-slot problem-type menu, or "off"
                                            #   (default deepseek-ai/DeepSeek-V4.1-Flash, thinking off: two fast calls)
CASCADE_VERIFY_SCRATCH=""                   # on (default) | off. Writer answer vs two blind cheap solvers + well-posedness
CASCADE_SOLVERS=""                          # 2+ openweight specs; default deepseek-ai/DeepSeek-V4.1-Flash@low,zai-org/GLM-5.3@low.
                                            #   Every writer rung needs one solver from a different model family.
CASCADE_VALIDITY=""                         # openweight spec for the well-posedness check, or "off" (default: last solver)
CASCADE_DIFFICULTY_SOLVER=""                # off (default) | openweight spec: weak-solver pass-rate filter. Leave off until
CASCADE_DIFFICULTY_TRIALS=""                #   a weak solver separates the band (eval:difficulty); trials per candidate (3)
CASCADE_DIFFICULTY_WINDOWS=""               # JSON [{"from":1,"to":5,"minRate":0.67,"maxRate":1}, ...] pass-rate windows by target
CASCADE_ANSWER_CHECK=""                     # on (default) | off. Code-computed answer checks (answer-check.ts): Anthropic writers
                                            #   write their own mathjs program; everyone else gets the blind program solver
CASCADE_PROGRAM_SOLVERS=""                  # blind program solvers in preference order, first of another family than the
                                            #   writer is used; default gemini:gemini-3.8-flash@low,openweight:deepseek-ai/DeepSeek-V4.1-Flash@low; "off"
CASCADE_TAXONOMY=""                         # on (default) | off. Contest slots drawn from data/corpus-taxonomy.json, recent types excluded
CASCADE_METHOD_JUDGE=""                     # same-practice judge for method-level dedup; default openweight:deepseek-ai/DeepSeek-V4.1-Flash@off; "off"
CASCADE_DIFFICULTY_JUDGE=""                 # difficulty judge (ladder mode vs E2H-rated anchors); default gemini:gemini-3.8-flash@low;
                                            #   openweight:zai-org/GLM-5.3@low also validated; "off"
CASCADE_DIFFICULTY_TOLERANCE=""             # reject when the judged rating is further than this from the slot's target (0 = record only)
CASCADE_COMPOSE=""                          # off (default) | on: upper-half slots combine two types (raises difficulty ~0.03 rating)
CASCADE_SEED_SLOTS=""                       # on (default) | off. Contest scratch slots become variants of real in-band problems whose type fits the topic
CASCADE_FIRST_TOKEN_SECONDS=""              # default 10. An open-weight write with no token by then is cancelled and resent (DeepInfra GLM stalls some requests)
CASCADE_FIRST_WAVE=""                       # candidates racing per slot from the start (1-4). Per tier: CASCADE_FIRST_WAVE_EASY|MID|HARD. Defaults easy 1, mid 3, hard 1
CASCADE_ASSUMPTION_VETO=""                  # on (default) | off: a cheap solver that had to assume something vetoes the candidate
CASCADE_REVERSE_SHARE=""                    # 0 (default) to 1: share of hard-tier seeds REVERSED (key read off the seed) instead of transposed
GENERATION_DAILY_CAP=""                     # generation attempts per user per UTC day, both pipelines (60)
#
# Required keys by configuration:
#   legacy (default)            ANTHROPIC_API_KEY, GOOGLE_API_KEY
#   cascade, default ladder     ANTHROPIC_API_KEY (+ GOOGLE_API_KEY while the plan stage runs on Gemini)
#   cascade + openweight rungs  the above + OPENWEIGHT_BASE_URL + OPENWEIGHT_API_KEY
#
# How the older generation variables behave under each pipeline:
#   variable                      legacy                 cascade
#   GENERATION_MODEL(_TIER)        tier writer model      ignored (the ladder names models)
#   GENERATION_MODEL_PLAN          plan model             plan model (same)
#   GENERATION_PROVIDER            per-stage vendor       plan + lesson stages only
#   GEMINI_MODEL(_*)               Gemini stage models    plan + lesson stages; gemini rungs name their own model
#   GENERATION_MODEL_EXPAND/VERIFY expand + audit stages  unused (no expand/audit stage)
#   GENERATION_NO_ADAPT            variant fallback       unused (variants always re-solve in one call)
#   GENERATION_NO_SEED_SKETCH      seed-sketch switch     unused
#   GENERATION_NO_SOLVE            solver kill switch     solver kill switch (same)
#   SOLVER_MODEL(_ESCALATE)        solver models          solver model (votes run in parallel at the top rung)
#   SOLVE_MAX_ESCALATIONS          sequential re-solves   unused (top rung: three parallel solves)

# Google OAuth — server-side only. Powers both the one-way DB → Calendar mirror
# AND "Sign in with Google" (the two flows share this one OAuth client + redirect
# URI, distinguished by the `state` param at the callback).
# Per-user: each user links their own calendar via OAuth; their refresh token is
# stored on the User row (not here). These are the app-wide OAuth client only —
# without CLIENT_ID/SECRET both the "Connect Google Calendar" and the "Continue
# with Google" sign-in options are hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google"
