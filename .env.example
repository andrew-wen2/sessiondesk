# Postgres (Neon or Supabase). Format below works for both.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Multi-user auth (middleware.ts). AUTH_SECRET signs the session cookie — set a
# long random value in prod (a blank/leaked secret lets anyone forge a session).
# A dev fallback keeps local runs working when unset.
AUTH_SECRET=""
# Optional: bootstrap login for `npm run seed` (owns the seeded roster).
SEED_EMAIL=""
SEED_PASSWORD=""

# Anthropic — server-side only, never NEXT_PUBLIC_. Added in build step 4.
ANTHROPIC_API_KEY=""
# GENERATION_MODEL overrides all tier-specific vars below (global escape hatch).
GENERATION_MODEL=""
GENERATION_MODEL_HARD="claude-sonnet-4-6"   # AIME #10–15: isomorphic variants from corpus seeds
GENERATION_MODEL_MID="claude-sonnet-4-6"    # AMC #16–25 / AIME #1–9: scratch with adaptive thinking
GENERATION_MODEL_EASY="claude-haiku-4-5"    # AMC #1–15 / unclassified: batch generate-from-scratch
# Adapt path (hard/variant): the model transforms a seed's real solution into a sketch,
# then a cheap model expands it. Thinking-cost optimization for AIME #10–15.
GENERATION_MODEL_EXPAND="claude-haiku-4-5"  # cheap model: sketch → full student-facing solution
GENERATION_MODEL_VERIFY=""                  # audit model (defaults to GENERATION_MODEL_EXPAND)
GENERATION_EFFORT_ADAPT="low"               # reasoning effort for the seed-adaptation pass (low|medium|high)
GENERATION_EFFORT_ESCALATE="high"           # effort for the heavy re-solve when an audit fails
GENERATION_VERIFY=""                        # set to "1" to enable the cheap correctness audit + escalation
GENERATION_NO_ADAPT=""                      # set to "1" to disable adapt and fall back to from-scratch variants
PARSE_MODEL="claude-sonnet-4-6"             # PDF chapter extraction (app/api/books/[id]/parse-pdf); separate from generation

# Google Calendar OAuth — server-side only. One-way DB → Calendar mirror.
# Per-user: each user links their own calendar via OAuth; their refresh token is
# stored on the User row (not here). These are the app-wide OAuth client only —
# without CLIENT_ID/SECRET the "Connect Google Calendar" option is hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google"
