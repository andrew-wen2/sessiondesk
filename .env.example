# Postgres (Neon or Supabase). Format below works for both.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Anthropic — server-side only, never NEXT_PUBLIC_. Added in build step 4.
ANTHROPIC_API_KEY=""
GENERATION_MODEL="claude-opus-4-8"

# Google Calendar OAuth — server-side only. Added in build step 5.
# One-way DB → Calendar mirror. Sync is skipped unless ID/SECRET/REFRESH_TOKEN are all set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google"
GOOGLE_REFRESH_TOKEN=""              # populated after the first OAuth flow (logged by the callback)
GOOGLE_TUTORING_CALENDAR_ID=""       # optional; defaults to "primary" if unset
