{
  "name": "session-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "check": "tsx scripts/check-lib.ts",
    "ingest:corpus": "tsx scripts/ingest-corpus.ts",
    "ingest:fma": "tsx scripts/ingest-fma.ts",
    "cleanup:corpus": "tsx scripts/cleanup-corpus.ts",
    "scrape:solutions": "tsx scripts/scrape-solutions.ts",
    "set-password": "tsx scripts/set-password.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "//browserslist": "Next's default client target is Safari 12, which makes SWC downlevel class fields. That transform miscompiles docx's ImageRun (a class field in a derived constructor) into `super(..._args)` inside a nested function — invalid JS that throws at parse time and kills whichever chunk it lands in. Modern targets keep class fields native and the library parses. This is an internal tool; nobody opens it on a 2018 browser.",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "googleapis": "^144.0.0",
    "katex": "^0.16.11",
    "next": "^15.1.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-katex": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-katex": "^3.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
